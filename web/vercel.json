{
    "version": 2,
    "builds": [
        {
        "src": "nuxt.config.js",
        "use": "@vercel/node"
        },
        {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": { "distDir": ".output/public" }
        }
    ],
    "routes": [
        {
        "src": "/(.*)",
        "dest": "/"
        }
    ]
}